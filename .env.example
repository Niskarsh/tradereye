# Google Sheets Configuration
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

GOOGLE_PRIVATE_KEY=""

GOOGLE_SHEET_ID=""

# Optional: Default Symbol for UI focus
NEXT_PUBLIC_DEFAULT_SYMBOL=""

AWS_REGION=""

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""

# --- Live capture / backfill (all optional) ---
# Only accept Dhan tokens issued for this client id on /api/live/* and /api/backfill/* (recommended).
ALLOWED_DHAN_CLIENT_ID=
# Enables the Dhan Postback webhook: https://<your-app>/api/live/postback?s=<this value>
POSTBACK_SECRET=

# --- Co-pilot (only the "Ask Claude" button needs the key; everything else works without it) ---
# Claude API key from https://platform.claude.com/settings/keys (billed separately from any Claude subscription)
ANTHROPIC_API_KEY=
# Optional settings (defaults shown)
COPILOT_MODEL=claude-sonnet-5-5
COPILOT_DAILY_LIMIT=25
COPILOT_RISK_INR=300
COPILOT_NIFTY_DIR_PCT=0.15
COPILOT_EMA_REACH_ATR=2
COPILOT_POC_ROWS=30
COPILOT_USD_INR=88
# "on" lets Claude think before answering (slower, costlier); default off
COPILOT_THINKING=off

# Google sign-in (only the owner gets in; see docs/auth.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# at least 32 random characters: openssl rand -base64 48
AUTH_SECRET=
OWNER_EMAIL=niskarshk@gmail.com
# shown on the "you're signed in" banner after your first sign-in; locks access to that exact Google account
OWNER_GOOGLE_ID=
# optional: the site's address if Google must always send you back there (default: the address you opened)
APP_URL=

# --- My Setups backtest (see docs/setups.md) ---
# fine-grained GitHub token (tradereye repo only, Actions: Read and write): lets the Re-run button start the backtest
GH_DISPATCH_TOKEN=
# optional: hit rate (0..1) a setup bucket needs before the Order Book alerts on it
SETUPS_ALERT_MIN_HIT=0.6

# --- YouTube & Instagram publishing (see docs/social.md) ---
# Instagram app id + secret from Meta: Instagram > API setup with Instagram login (not the Facebook app id)
IG_APP_ID=
IG_APP_SECRET=
# optional: the only YouTube channel / Instagram account tradereye will post to (defaults shown)
YOUTUBE_CHANNEL_HANDLE=@CandlesBeforeCubicles
IG_USERNAME=candlesbeforecubicles
